{
  "name": "portfolio-lucafeine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site personnel de lucafeine — dépôts et commits GitHub, bio et contact.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c auto \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "check": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/newsreader": "^5.2.9",
    "compression": "^1.8.1",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
