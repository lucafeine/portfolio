# Copiez ce fichier en .env sur le VPS, puis renseignez le token.
# Un token est optionnel, mais évite la limite de 60 requêtes/heure par IP.

GITHUB_USER=lucafeine

# Token GitHub fine-grained, lecture seule sur les dépôts publics.
# Créez-le ici : https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Durée du cache serveur, en millisecondes (10 minutes par défaut).
CACHE_TTL_MS=600000
